{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dashboard", "destination": "/pages/dashboard.html" },
    { "source": "/shortcuts", "destination": "/pages/shortcuts.html" },
    { "source": "/docs", "destination": "/pages/docs.html" },
    { "source": "/terms", "destination": "/pages/terms.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/preview.png", "destination": "/assets/preview.png" },
    { "source": "/icons/streak.png", "destination": "/assets/streak.png" },
    { "source": "/favicon.ico", "destination": "/assets/favicon.ico" },
    { "source": "/apple-touch-icon.png", "destination": "/assets/apple-touch-icon.png" },
    { "source": "/apple-touch-icon-precomposed.png", "destination": "/assets/apple-touch-icon.png" },
    { "source": "/logo.png", "destination": "/assets/logo.png" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
